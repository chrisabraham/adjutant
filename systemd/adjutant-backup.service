# Copy both files to ~/.config/systemd/user/, adjust the path, then:
#   systemctl --user daemon-reload && systemctl --user enable --now adjutant-backup.timer
#   loginctl enable-linger "$USER"     # so it runs while you're logged out
[Unit]
Description=Adjutant encrypted backup (restore-tested)

[Service]
Type=oneshot
# Environment=ADJUTANT_BACKUP_REPO=%h/adjutant-backup
ExecStart=%h/adjutant/tools/backup.sh
